# Database
DATABASE_URL=postgresql://user:password@localhost:5432/scholarmap

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.2
OPENAI_REASONING_EFFORT=high

# Authentication
JWT_SECRET_KEY=your-secure-random-secret-key-here

# Email Configuration (Gmail)
# Get App Password from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-gmail-app-password-here

# Optional: Other API keys
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
PUBMED_API_KEY=

# Super user (bypasses ownership checks) — keep out of git
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=

# Public site URL (backend CORS / origin checks)
FRONTEND_URL=https://scholarmap-frontend.onrender.com
# Extra allowed origins, comma-separated (e.g. old domain during migration)
CORS_EXTRA_ORIGINS=

# Frontend (set in frontend/.env.local or hosting env):
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Paddle billing (backend)
PADDLE_ENVIRONMENT=sandbox            # sandbox | production
PADDLE_API_KEY=                       # server-side API key (customer portal)
PADDLE_WEBHOOK_SECRET=                # notification destination secret key
# Paddle billing (frontend, public values):
# NEXT_PUBLIC_PADDLE_ENV=sandbox
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=pri_...
# NEXT_PUBLIC_PADDLE_PRICE_QUARTERLY=pri_...
